rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chi e' entrato con utente e password (gli anonimi del QR non passano).
    function registrato() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Chiunque abbia una identita', anche quella anonima del gioco.
    function connesso() {
      return request.auth != null;
    }

    function admin() {
      return registrato() && request.auth.token.email == 'oder@laurea.local';
    }

    function statoPartita() {
      return get(/databases/$(database)/documents/partita/corrente).data.stato;
    }

    // --- CruciSara: parole e definizioni ---------------------------------
    function parolaValida(d) {
      return d.parola is string
        && d.parola.size() >= 3
        && d.parola.size() <= 15
        && d.definizione is string
        && d.definizione.size() > 0
        && d.definizione.size() <= 300
        && d.autore is string
        && d.autore.size() <= 40;
    }

    match /parole/{id} {
      allow read: if registrato();
      allow create: if registrato() && parolaValida(request.resource.data);
      allow update: if admin() && parolaValida(request.resource.data);
      allow delete: if admin();
    }

    // --- BingoSara: previsioni sulla serata ------------------------------
    function fraseValida(d) {
      return d.testo is string
        && d.testo.size() >= 3
        && d.testo.size() <= 80
        && d.autore is string
        && d.autore.size() <= 40;
    }

    match /frasi/{id} {
      allow read: if registrato();
      allow create: if registrato() && fraseValida(request.resource.data);
      allow update: if admin() && fraseValida(request.resource.data);
      allow delete: if admin();
    }

    // --- Cash or Sara ----------------------------------------------------
    // Gli oggetti contengono le valutazioni vere: nessuno all'infuori di Oder
    // puo' nemmeno leggerli. Agli invitati arriva solo quello che Oder mette
    // nel documento della partita.
    match /oggetti/{id} {
      allow read, write: if admin();
    }

    match /partita/{partitaId} {
      allow read: if connesso();
      allow write: if admin();

      match /giocatori/{giocatoreId} {
        allow read: if connesso();
        allow create, update: if admin()
          || (connesso()
              && request.auth.uid == giocatoreId
              && request.resource.data.nome is string
              && request.resource.data.nome.size() >= 2
              && request.resource.data.nome.size() <= 24);
        allow delete: if admin();
      }

      match /risposte/{rispostaId} {
        allow read: if connesso();
        // si punta solo su se stessi e solo mentre le puntate sono aperte
        allow create, update: if admin()
          || (connesso()
              && request.resource.data.giocatoreId == request.auth.uid
              && request.resource.data.valore is number
              && request.resource.data.valore >= 0
              && request.resource.data.valore <= 1000000
              && statoPartita() == 'puntate');
        allow delete: if admin();
      }
    }

    // Tutto il resto e' chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
